# Copy to .env and edit. NEVER commit real secrets.
DATABASE_URL="file:./dev.db"

# Public base URL (used in email links)
APP_URL="http://localhost:3000"

# Company-facing email addresses (placeholders until the company supplies real ones)
ADMIN_NOTIFY_EMAIL="admin@isolative.example"
HR_NOTIFY_EMAIL="hr@isolative.example"   # receives "application ready for review"

# Private document storage (outside public/, never served directly). Back this folder up with the database.
DOCUMENT_DIR="storage/documents"
MAIL_FROM="Isolative Electricals <no-reply@isolative.example>"

# SMTP. For local demos run Mailpit (https://mailpit.axllent.org) on 1025, UI on 8025.
# Leave SMTP_HOST empty to skip real sending: emails are still recorded in the Email Log (status LOGGED).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""

# Seed passwords (development only). Change before any real use.
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_HR_PASSWORD="Hr@12345678"

# Optional: lets an external scheduler (cron / Windows Task Scheduler) trigger meeting reminders:
#   curl -X POST -H "Authorization: Bearer <secret>" http://localhost:3000/api/cron/reminders
# The endpoint is switched off while this is empty. Use a long random value.
CRON_SECRET=""
